{
  "expo": {
    "name": "CSH",
    "slug": "cos",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.circlesupporthealth.csh",
      "buildNumber": "10",
      "associatedDomains": [
        "applinks:circlesupporthealth.ai",
        "applinks:*.circlesupporthealth.ai"
      ],
      "appleTeamId": "Y9J46AL3G2",
      "infoPlist": {
        "NSCameraUsageDescription": "Circle Support Health needs camera access to photograph documents and prescriptions.",
        "NSContactsUsageDescription": "Circle Support Health uses contacts to help you add emergency contacts quickly.",
        "NSPhotoLibraryUsageDescription": "Circle Support Health needs photo library access to upload health documents.",
        "NSFaceIDUsageDescription": "Circle Support Health uses Face ID to securely unlock your health information.",
        "NSHealthShareUsageDescription": "Circle Support Health reads your activity, heart rate, and sleep data to show a personalized daily health summary.",
        "NSHealthUpdateUsageDescription": "Circle Support Health updates your health data so your care team has the latest information.",
        "NSCalendarsUsageDescription": "Circle Support Health reads your calendar so personal appointments appear alongside your medical visits in one place. Event details stay on this device.",
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.circlesupporthealth.csh",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "circlesupporthealth.ai",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "*.circlesupporthealth.ai",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_CALENDAR",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_SPEED",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.READ_MINDFULNESS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "url": "https://u.expo.dev/30bc49bd-ee12-4a06-86b3-ee4f23690114",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": "1.4.0",
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-font",
      "expo-image",
      "expo-tracking-transparency",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Circle Support Health reads your calendar so personal appointments appear alongside your medical visits in one place. Event details stay on this device."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io",
          "organization": "circle-support-health",
          "project": "cos-app"
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30bc49bd-ee12-4a06-86b3-ee4f23690114"
      }
    },
    "owner": "maximilien14s-organization"
  }
}
