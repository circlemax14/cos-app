<!-- Android 11 and lower. Paired with android:allowBackup="false" so that
     even a device ignoring this file has backup switched off outright. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
