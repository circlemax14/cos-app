# cos-app STAGING client config.
# Derived from .env.prod so the key set can never drift; only the four
# values below differ. EXPO_PUBLIC_* are PUBLIC client identifiers that
# Expo inlines into the JS bundle at build time - they are not secrets.
#
# Cognito is intentionally SHARED with dev (see cos-backend
# scripts/validate-deploy-env.mjs -> EXPECTED_BY_STAGE.staging).

# Backend API (Production)
EXPO_PUBLIC_API_BASE_URL=https://api.staging.circlesupporthealth.ai/

# AWS Cognito
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_T5uZyFxGC
EXPO_PUBLIC_COGNITO_CLIENT_ID=shrg82vtrbgqjanmh5hn247mj
EXPO_PUBLIC_COGNITO_REGION=us-east-1

# Fasten Health
EXPO_PUBLIC_FASTEN_PUBLIC_ID=public_test_et389iol5extr2acodl49rf70y18hw6c4k495uvm0sf4x

# Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=819915532646-mr5a90b6pbk0tvjl9d7bon3l1lpcqrjq.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=819915532646-hhdggafmagr2qa2g64jkt49hidfbj9t8.apps.googleusercontent.com
